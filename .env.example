# SLSKD Connection (Defaults to http://localhost:5030)
SLSKD_URL=http://localhost:5030

# Authentication (Works automatically with default "slskd" / "slskd")
SLSKD_USERNAME=slskd
SLSKD_PASSWORD=slskd

# Optional API Key (if you configured one in slskd.yml)
# SLSKD_API_KEY=

# Optional Directory Overrides (leave blank for default Desktop/AkamoPlaylist)
# SLSKD_DOWNLOADS_DIR=
# TARGET_PLAYLIST_DIR=
